{
  "name": "kerodev-cli",
  "version": "1.0.0",
  "description": "Enterprise-grade universal project scaffolding CLI by KeroDev",
  "type": "module",
  "bin": {
    "kerodev": "./dist/index.js",
    "kd": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@inquirer/prompts": "^5.0.0",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "gradient-string": "^2.0.2",
    "ora": "^8.0.1",
    "which": "^4.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^20.11.0",
    "@types/which": "^3.0.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["cli", "scaffolding", "generator", "next", "react", "flutter", "kerodev", "nextjs", "tailwind"],
  "license": "MIT"
}
